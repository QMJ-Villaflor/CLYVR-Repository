# Copy this file to .env and replace placeholders locally.
# Never commit .env or share its secret values.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_HOST:5432/postgres
SUPABASE_DB_USER=YOUR_RESTRICTED_DEV_ROLE
SUPABASE_DB_PASSWORD=YOUR_LOCAL_PASSWORD

# Backend HTTP settings. The service defaults to listening on loopback.
BACKEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
CLYVR_BACKEND_URL=http://127.0.0.1:8080

# Server-only Firebase Scrypt password hash parameters matching public.users.password_hash.
# Obtain these from the account that created the stored hashes; never commit real values.
CLYVR_HASH_SIGNER_KEY=YOUR_BASE64_SCRYPT_SIGNER_KEY
CLYVR_HASH_SALT_SEPARATOR=YOUR_BASE64_SCRYPT_SALT_SEPARATOR

# Doctor directory aliases -> database doctor IDs.
CLYVR_DEMO_DOCTOR_ID_D1=YOUR_SYNTHETIC_DOCTOR_ID_D1
CLYVR_DEMO_DOCTOR_ID_D2=YOUR_SYNTHETIC_DOCTOR_ID_D2
CLYVR_DEMO_DOCTOR_ID_D3=YOUR_SYNTHETIC_DOCTOR_ID_D3
CLYVR_DEMO_DOCTOR_ID_D4=YOUR_SYNTHETIC_DOCTOR_ID_D4
